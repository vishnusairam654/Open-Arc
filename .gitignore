# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# =========================================================
# AI CONTEXT & TOKEN OPTIMIZATION DETECTOR BLOCK
# =========================================================

# 1. Block heavy binary assets (Agents cannot code based on raw asset bytes)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.ico
*.mp4
*.mov
*.webm
*.pdf

# 2. Block typography and local design assets
*.ttf
*.woff
*.woff2
*.eot
*.otf

# 3. Block system-wide log bloating 
*.log
logs/
*.local

# 4. Block IDE telemetry/state metadata that drains token streams
.vscode/
.idea/
.history/